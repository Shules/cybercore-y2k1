#!/bin/bash
set -eo pipefail

BACKUP_DIR="$1"
if [ -z "$BACKUP_DIR" ] || [ ! -d "$BACKUP_DIR" ]; then
    echo "Usage: cybercore-restore <path-to-backup-dir>"
    exit 1
fi

echo "=========================================="
echo "Restoring Cybercore Y2K1 Full State"
echo "Source: $BACKUP_DIR"
echo "=========================================="

# Validation of backup structure
if [ ! -d "$BACKUP_DIR/config" ] || [ ! -d "$BACKUP_DIR/local_share" ] || [ ! -d "$BACKUP_DIR/local_bin" ]; then
    echo "ERROR: Invalid backup archive. Missing essential directories."
    exit 1
fi

# 1. Configs
echo "[1] Restoring application configurations..."
cp -a "$BACKUP_DIR"/config/* "$HOME/.config/"

# 2. Systemd services
echo "[2] Restoring systemd user services..."
if [ -d "$BACKUP_DIR/systemd" ]; then
    mkdir -p "$HOME/.config/systemd/user"
    cp -a "$BACKUP_DIR"/systemd/* "$HOME/.config/systemd/user/"
    systemctl --user daemon-reload
    systemctl --user enable conky.service glava.service cybercore-gpu.service
fi

# 3. Plasmoids and local_share assets
echo "[3] Restoring plasmoids, themes, icons, fonts..."
if [ -d "$BACKUP_DIR/local_share/plasma/plasmoids" ]; then
    mkdir -p "$HOME/.local/share/plasma/plasmoids"
    cp -a "$BACKUP_DIR"/local_share/plasma/plasmoids/* "$HOME/.local/share/plasma/plasmoids/"
fi
if [ -d "$BACKUP_DIR/local_share/plasma/desktoptheme" ]; then
    mkdir -p "$HOME/.local/share/plasma/desktoptheme"
    cp -a "$BACKUP_DIR"/local_share/plasma/desktoptheme/* "$HOME/.local/share/plasma/desktoptheme/"
fi
if [ -d "$BACKUP_DIR/local_share/color-schemes" ]; then
    mkdir -p "$HOME/.local/share/color-schemes"
    cp -a "$BACKUP_DIR"/local_share/color-schemes/* "$HOME/.local/share/color-schemes/"
fi
if [ -d "$BACKUP_DIR/local_share/konsole" ]; then
    mkdir -p "$HOME/.local/share/konsole"
    cp -a "$BACKUP_DIR"/local_share/konsole/* "$HOME/.local/share/konsole/"
fi
if [ -d "$BACKUP_DIR/local_share/icons" ]; then
    mkdir -p "$HOME/.local/share/icons"
    cp -a "$BACKUP_DIR"/local_share/icons/* "$HOME/.local/share/icons/"
fi
if [ -d "$BACKUP_DIR/local_share/fonts" ]; then
    mkdir -p "$HOME/.local/share/fonts"
    cp -a "$BACKUP_DIR"/local_share/fonts/* "$HOME/.local/share/fonts/"
    fc-cache -f "$HOME/.local/share/fonts/" >/dev/null 2>&1 || true
fi
if [ -d "$BACKUP_DIR/local_share/applications/krunner_cmds" ]; then
    mkdir -p "$HOME/.local/share/applications/krunner_cmds"
    cp -a "$BACKUP_DIR"/local_share/applications/krunner_cmds/* "$HOME/.local/share/applications/krunner_cmds/"
    kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
fi

# 4. Binaries
echo "[4] Restoring local executables..."
mkdir -p "$HOME/.local/bin"
cp -a "$BACKUP_DIR"/local_bin/* "$HOME/.local/bin/"
chmod +x "$HOME"/.local/bin/*

# 5. Reload session components
echo "[5] Reloading KWin and compositor..."
qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true

echo "=========================================="
echo "Restore complete! Restart session if desired."
echo "=========================================="
