#!/bin/bash
set -eo pipefail

TARGET_BASE="${1:-$HOME/cybercore-backups/$(date +%Y%m%d_%H%M%S)}"
TMP_BACKUP="${TARGET_BASE}.tmp.$$"

echo "=========================================="
echo "Creating Cybercore Y2K1 Complete State Backup"
echo "Target directory: $TARGET_BASE"
echo "=========================================="

# Create temporary staging directory for atomic commit
mkdir -p "$TMP_BACKUP"/{config,local_bin,local_share,systemd}

# 1. KDE & Plasma configs
echo "[1] Backing up core KDE, KWin, Klassy, Kvantum, Conky, Glava, Fastfetch..."
for cfg in kdeglobals kwinrc dolphinrc krunnerrc kwinrulesrc kglobalshortcutsrc \
           plasmashellrc plasma-org.kde.plasma.desktop-appletsrc; do
    if [ -f "$HOME/.config/$cfg" ]; then
        cp "$HOME/.config/$cfg" "$TMP_BACKUP/config/"
    fi
done
for dir in klassy Kvantum conky glava fastfetch; do
    if [ -d "$HOME/.config/$dir" ]; then
        cp -r "$HOME/.config/$dir" "$TMP_BACKUP/config/"
    fi
done

# 2. Systemd User services
echo "[2] Backing up systemd user services..."
for svc in cybercore-gpu.service conky.service glava.service; do
    if [ -f "$HOME/.config/systemd/user/$svc" ]; then
        cp "$HOME/.config/systemd/user/$svc" "$TMP_BACKUP/systemd/"
    fi
done

# 3. Plasmoids (both com.cybercore and third-party virtualdesktopbar)
echo "[3] Backing up all custom Plasma desktop widgets..."
mkdir -p "$TMP_BACKUP/local_share/plasma/plasmoids"
for p in "$HOME"/.local/share/plasma/plasmoids/com.cybercore.* \
         "$HOME"/.local/share/plasma/plasmoids/org.kde.plasma.virtualdesktopbar; do
    if [ -d "$p" ]; then
        cp -r "$p" "$TMP_BACKUP/local_share/plasma/plasmoids/"
    fi
done

# 4. Plasma Desktop Themes, Color Schemes, Konsole, Icons and Fonts
echo "[4] Backing up themes, color schemes, Konsole profiles, icons, fonts..."
mkdir -p "$TMP_BACKUP/local_share/plasma/desktoptheme"
if [ -d "$HOME/.local/share/plasma/desktoptheme/Cybercore-Y2K1" ]; then
    cp -r "$HOME/.local/share/plasma/desktoptheme/Cybercore-Y2K1" "$TMP_BACKUP/local_share/plasma/desktoptheme/"
fi

mkdir -p "$TMP_BACKUP/local_share/color-schemes"
cp "$HOME"/.local/share/color-schemes/Cybercore* "$TMP_BACKUP/local_share/color-schemes/" 2>/dev/null || true

mkdir -p "$TMP_BACKUP/local_share/konsole"
if [ -d "$HOME/.local/share/konsole" ]; then
    cp -r "$HOME/.local/share/konsole"/* "$TMP_BACKUP/local_share/konsole/" 2>/dev/null || true
fi

mkdir -p "$TMP_BACKUP/local_share/icons"
if [ -d "$HOME/.local/share/icons/phosphor" ]; then
    cp -r "$HOME/.local/share/icons/phosphor" "$TMP_BACKUP/local_share/icons/"
fi
if [ -d "$HOME/.local/share/icons/Cybercore-Bars" ]; then
    cp -r "$HOME/.local/share/icons/Cybercore-Bars" "$TMP_BACKUP/local_share/icons/"
fi

mkdir -p "$TMP_BACKUP/local_share/fonts"
if [ -d "$HOME/.local/share/fonts" ]; then
    cp -r "$HOME/.local/share/fonts"/* "$TMP_BACKUP/local_share/fonts/" 2>/dev/null || true
fi

# 5. KRunner command desktop entries
mkdir -p "$TMP_BACKUP/local_share/applications/krunner_cmds"
if [ -d "$HOME/.local/share/applications/krunner_cmds" ]; then
    cp -r "$HOME/.local/share/applications/krunner_cmds"/* "$TMP_BACKUP/local_share/applications/krunner_cmds/" 2>/dev/null || true
fi

# 6. Binaries and KRunner command scripts
echo "[5] Backing up scripts and binaries..."
for b in cybercore-gpu cybercore-gpu-daemon cybercore-toggle-desktop cybercore-backup cybercore-restore; do
    if [ -f "$HOME/.local/bin/$b" ]; then
        cp -L "$HOME/.local/bin/$b" "$TMP_BACKUP/local_bin/"
    fi
done
# Backup all krunner commands
for kr in "$HOME/.local/bin"/{br*,bt,cl,dd,ka,mc,m*,ss,t*,v*,w*}; do
    if [ -f "$kr" ]; then
        cp -L "$kr" "$TMP_BACKUP/local_bin/" 2>/dev/null || true
    fi
done

# 7. Verification & Atomic commit
echo "[6] Validating backup integrity..."
if [ ! -d "$TMP_BACKUP/config" ] || [ ! -d "$TMP_BACKUP/local_share" ] || [ ! -d "$TMP_BACKUP/local_bin" ]; then
    echo "ERROR: Backup integrity validation failed. Aborting."
    rm -rf "$TMP_BACKUP"
    exit 1
fi

mkdir -p "$(dirname "$TARGET_BASE")"
mv "$TMP_BACKUP" "$TARGET_BASE"

echo "=========================================="
echo "Backup successfully committed to:"
echo "  $TARGET_BASE"
echo "=========================================="
