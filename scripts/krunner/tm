#!/bin/bash
set -euo pipefail
minutes=${1:-}
# Limit to seven days; ceil to one second minimum, never schedule zero seconds.
if ! seconds=$(awk -v val="$minutes" 'BEGIN {
    if (val !~ /^[0-9]+([.][0-9]+)?$/ || val+0 <= 0 || val+0 > 10080) exit 1;
    n=val*60; whole=int(n); if (n>whole) whole++; if (whole<1) whole=1;
    printf "%d", whole;
}'); then
    notify-send -u critical "Timer Error" "Use a positive duration up to 10080 minutes."
    exit 1
fi
message=${2:-"Timer for $minutes mins is up!"}
(sleep "$seconds" && notify-send -u critical "TIMER COMPLETE" "$message" --icon=dialog-warning) &
notify-send -t 2500 "Timer Set" "Will alert in $seconds seconds // $message"
