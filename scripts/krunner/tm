#!/bin/bash
if [ -z "$1" ]; then
    notify-send -u critical "Timer Error" "Usage: tm <minutes> [label]"
    exit 1
fi

raw_min="$1"
# Check if $raw_min is a valid positive number using pure bash / awk
is_pos=$(awk -v val="$raw_min" 'BEGIN { if (val ~ /^[0-9]+(\.[0-9]+)?$/ && val > 0) print 1; else print 0 }')

if [ "$is_pos" != "1" ]; then
    notify-send -u critical "Timer Error" "Invalid duration: '$raw_min'. Specify a positive number of minutes."
    exit 1
fi

MSG="${2:-"Timer for $raw_min mins is up!"}"
seconds=$(awk -v val="$raw_min" 'BEGIN { printf "%.0f", val * 60 }')

(sleep "$seconds" && notify-send -u critical "TIMER COMPLETE" "$MSG" --icon=dialog-warning) &
notify-send -t 2500 "Timer Set" "Will alert in $raw_min minute(s) // $MSG"
