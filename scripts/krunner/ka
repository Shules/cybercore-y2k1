#!/bin/bash
if [ -z "$1" ]; then
    exit 1
fi

target="$1"
current_pid=$$

# Function to check matching pids excluding current script process
get_target_pids() {
    pgrep -x "$target" 2>/dev/null | grep -v "^$current_pid$" || true
}

matching_pids=$(get_target_pids)

if [ -z "$matching_pids" ]; then
    notify-send -t 2000 "Kill: Not Found" "No running process matched '$target'."
    exit 0
fi

# Attempt graceful termination first (SIGTERM)
kill $matching_pids 2>/dev/null
sleep 0.5

remaining_pids=$(get_target_pids)

if [ -n "$remaining_pids" ]; then
    # Force kill if still lingering
    kill -9 $remaining_pids 2>/dev/null
    sleep 0.2
    lingering=$(get_target_pids)
    if [ -n "$lingering" ]; then
        notify-send -u critical "Kill Failed" "Could not terminate $target."
        exit 1
    else
        notify-send -t 2000 "Process Force-Killed" "$target was forcefully terminated (SIGKILL)."
    fi
else
    notify-send -t 2000 "Process Terminated" "$target was cleanly closed (SIGTERM)."
fi
