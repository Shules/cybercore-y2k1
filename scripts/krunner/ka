#!/bin/bash
if [ -z "$1" ]; then
    exit 1
fi

target="$1"

if ! pgrep -f "$target" >/dev/null 2>&1; then
    notify-send -t 2000 "Kill: Not Found" "No running process matched '$target'."
    exit 0
fi

# Attempt graceful termination first (SIGTERM)
killall "$target" 2>/dev/null
sleep 0.5

if pgrep -f "$target" >/dev/null 2>&1; then
    # Force kill if still lingering
    killall -9 "$target" 2>/dev/null
    sleep 0.2
    if pgrep -f "$target" >/dev/null 2>&1; then
        notify-send -u critical "Kill Failed" "Could not terminate $target."
        exit 1
    else
        notify-send -t 2000 "Process Force-Killed" "$target was forcefully terminated (SIGKILL)."
    fi
else
    notify-send -t 2000 "Process Terminated" "$target was cleanly closed (SIGTERM)."
fi
