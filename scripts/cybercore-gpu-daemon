#!/bin/bash
CACHE="/dev/shm/cybercore_gpu_conky"

# Trap termination signals to clean up cache file
cleanup() {
    rm -f "$CACHE" "$CACHE.tmp"
    exit 0
}
trap cleanup SIGINT SIGTERM

while true; do
    raw=$(nvidia-smi --query-gpu=temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw,fan.speed --format=csv,noheader,nounits 2>/dev/null)
    if [ -n "$raw" ]; then
        IFS=',' read -r temp util memused memtotal power fan <<< "$raw"
        temp="${temp// /}"
        util="${util// /}"
        memused="${memused// /}"
        memtotal="${memtotal// /}"
        power="${power// /}"
        fan="${fan// /}"

        memutil=0
        if [ "${memtotal:-0}" -gt 0 ] 2>/dev/null; then
            memutil=$(( (memused * 100) / memtotal ))
        fi
        powerint="${power%.*}"
        now_ts=$(date +%s)

        cat << EOF_INNER > "$CACHE.tmp"
timestamp ${now_ts}
temp ${temp:-0}
util ${util:-0}
memused ${memused:-0}
memtotal ${memtotal:-0}
memutil ${memutil:-0}
power ${powerint:-0}
fan ${fan:-0}
EOF_INNER
        mv "$CACHE.tmp" "$CACHE"
    fi
    sleep 2
done
