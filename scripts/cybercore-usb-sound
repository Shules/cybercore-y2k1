#!/usr/bin/env python3
"""Cybercore Y2K1 - USB Hardware Sound Daemon.
Monitors USB connect and disconnect events via udev and plays
the Longhorn / Vista Beta hardware sound effects directly via PipeWire.
Does not emit any desktop notification popups.
"""
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

SOUND_DIR = Path.home() / ".local/share/sounds/Cybercore-Longhorn/stereo"
ADD_SOUND_OGA = SOUND_DIR / "device-added.oga"
ADD_SOUND_WAV = SOUND_DIR / "device-added.wav"
REMOVE_SOUND_OGA = SOUND_DIR / "device-removed.oga"
REMOVE_SOUND_WAV = SOUND_DIR / "device-removed.wav"

def get_sound(action: str) -> str | None:
    if action == "add":
        if ADD_SOUND_OGA.exists():
            return str(ADD_SOUND_OGA)
        if ADD_SOUND_WAV.exists():
            return str(ADD_SOUND_WAV)
    elif action == "remove":
        if REMOVE_SOUND_OGA.exists():
            return str(REMOVE_SOUND_OGA)
        if REMOVE_SOUND_WAV.exists():
            return str(REMOVE_SOUND_WAV)
    return None

def play_sound(sound_path: str):
    try:
        subprocess.Popen(
            ["pw-play", sound_path],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        pass

def main():
    cmd = ["udevadm", "monitor", "--udev", "--subsystem-match=usb/usb_device"]
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            bufsize=1,
        )
    except Exception as e:
        sys.stderr.write(f"Failed to start udevadm monitor: {e}\n")
        sys.exit(1)

    def handle_signal(sig, frame):
        proc.terminate()
        sys.exit(0)

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    last_event_time = 0.0
    last_action = ""
    DEBOUNCE_WINDOW = 0.45

    for line in proc.stdout:
        parts = line.strip().split()
        if len(parts) >= 3 and parts[0] == "UDEV":
            action = parts[2]
            if action in ("add", "remove"):
                now = time.monotonic()
                if action == last_action and (now - last_event_time) < DEBOUNCE_WINDOW:
                    continue
                last_event_time = now
                last_action = action

                sound = get_sound(action)
                if sound:
                    play_sound(sound)

if __name__ == "__main__":
    main()
